<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#eef0dc" />
  <meta name="description" content="青禾中文——面向已有中文基础学习者的沉浸式 HSK 学习 Demo。" />
  <title>青禾中文 · HSK 沉浸式学习</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%236e8064'/%3E%3Cpath d='M17 40c13 1 22-8 29-22 2 16-3 30-18 31-6 0-10-3-11-9Z' fill='%23f7f1dc'/%3E%3Cpath d='M19 45c7-8 14-14 25-22' stroke='%23f7f1dc' stroke-width='3' stroke-linecap='round'/%3E%3C/svg%3E" />
  <style>
    :root{--cream:#f7f3e7;--paper:#fffdf7;--sage:#dfe7d6;--sage-2:#cbd8bf;--leaf:#60735a;--ink:#29322a;--muted:#748073;--line:#dde2d4;--warm:#e9dbb9;--soft:#f2eddf;--shadow:0 18px 50px rgba(64,76,56,.09);--r:22px}
    *{box-sizing:border-box} body{margin:0;background:linear-gradient(135deg,#f6f1df 0%,#eef2df 100%);color:var(--ink);font:16px/1.65 ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans SC","Microsoft YaHei",sans-serif;min-height:100vh} button,input,textarea{font:inherit;color:inherit} button{cursor:pointer}
    .app{max-width:1320px;margin:auto;min-height:100vh;display:grid;grid-template-columns:252px 1fr;gap:28px;padding:24px}.sidebar{background:rgba(255,253,247,.86);backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,.75);border-radius:28px;padding:28px 20px;display:flex;flex-direction:column;min-height:calc(100vh - 48px);position:sticky;top:24px;box-shadow:var(--shadow)}
    .brand{display:flex;align-items:center;gap:12px;padding:0 9px 28px}.brandmark{width:42px;height:42px;background:var(--leaf);border-radius:14px;display:grid;place-items:center;color:white}.brandmark svg{width:25px}.brand strong{display:block;font-size:20px;letter-spacing:.08em}.brand small{color:var(--muted);font-size:12px;letter-spacing:.06em}.nav{display:grid;gap:7px}.nav button{border:0;background:transparent;padding:13px 14px;border-radius:14px;text-align:left;display:flex;gap:12px;align-items:center;font-weight:600;color:#596458;transition:.2s}.nav button:hover,.nav button.active{background:var(--sage);color:#334131}.nav svg{width:20px;height:20px;stroke-width:1.7}.side-bottom{margin-top:auto}.modebox{background:#eff2e8;border:1px solid var(--line);border-radius:18px;padding:15px}.mode-row{display:flex;align-items:center;justify-content:space-between;font-weight:650}.modebox small{display:block;color:var(--muted);margin-top:6px;line-height:1.45}.switch{width:44px;height:25px;background:#aeb7aa;border:0;border-radius:999px;padding:3px;transition:.2s}.switch i{display:block;width:19px;height:19px;border-radius:50%;background:white;transition:.2s}.switch.on{background:var(--leaf)}.switch.on i{transform:translateX(19px)}
    main{padding:10px 10px 38px;min-width:0}.topbar{height:58px;display:flex;justify-content:space-between;align-items:center;margin-bottom:26px}.eyebrow{color:var(--leaf);font-size:13px;font-weight:750;letter-spacing:.12em}.top-actions{display:flex;gap:10px;align-items:center}.iconbtn{width:42px;height:42px;border-radius:14px;border:1px solid var(--line);background:rgba(255,253,247,.72);display:grid;place-items:center}.iconbtn svg{width:19px}.avatar{width:42px;height:42px;border-radius:50%;background:#c9d6be;display:grid;place-items:center;font-weight:750}
    .view{display:none;animation:rise .35s ease}.view.active{display:block}@keyframes rise{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}h1,h2,h3,p{margin-top:0}h1{font-size:clamp(30px,4vw,46px);line-height:1.2;letter-spacing:-.04em;margin-bottom:10px}h2{font-size:26px;line-height:1.3}h3{font-size:18px}.sub{color:var(--muted)}
    .home-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:26px}.date-chip{padding:8px 13px;background:rgba(255,255,255,.55);border:1px solid var(--line);border-radius:99px;color:var(--muted);font-size:14px}.grid{display:grid;grid-template-columns:1.55fr .9fr;gap:22px}.card{background:rgba(255,253,247,.88);border:1px solid rgba(255,255,255,.85);border-radius:var(--r);padding:24px;box-shadow:0 8px 28px rgba(69,82,61,.055)}
    .lesson-card{background:linear-gradient(145deg,#dfe8d5,#edf0dd);padding:32px;min-height:328px;position:relative;overflow:hidden}.lesson-card:after{content:"迟";position:absolute;right:24px;bottom:-56px;font-size:220px;line-height:1;color:rgba(83,108,76,.07);font-family:serif}.pill{display:inline-flex;border-radius:99px;background:rgba(255,255,255,.62);padding:6px 11px;font-size:13px;font-weight:700;color:var(--leaf)}.lesson-card h2{font-size:34px;margin:52px 0 6px;position:relative;z-index:1}.meta{color:#687465;margin-bottom:28px}.primary,.secondary{border:0;border-radius:13px;padding:12px 19px;font-weight:750;position:relative;z-index:1}.primary{background:var(--leaf);color:white;box-shadow:0 7px 18px rgba(74,97,68,.2)}.primary:hover{background:#506749}.secondary{background:#edf1e7;border:1px solid var(--line)}.progressline{height:7px;background:rgba(255,255,255,.7);border-radius:99px;overflow:hidden;margin-top:30px}.progressline span{display:block;width:38%;height:100%;background:var(--leaf);border-radius:inherit}
    .review-card h3,.week-card h3{display:flex;justify-content:space-between;align-items:center}.review-counts{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:20px 0}.count{text-align:center;background:var(--soft);border-radius:14px;padding:13px 4px}.count b{display:block;font-size:23px}.count small{color:var(--muted)}.wide{width:100%}.week{display:flex;align-items:end;justify-content:space-between;height:86px;margin-top:18px}.bar{width:10%;height:var(--h);background:#d9ddcf;border-radius:8px 8px 3px 3px;position:relative}.bar.done{background:#8ea284}.bar:after{content:attr(data-d);position:absolute;top:calc(100% + 7px);left:50%;transform:translateX(-50%);font-size:12px;color:var(--muted)}
    .section-head{display:flex;justify-content:space-between;gap:20px;align-items:end;margin-bottom:24px}.section-head p{margin-bottom:0}.learn-layout{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:22px}.lesson-main{min-height:640px}.stepper{display:flex;gap:7px;margin-bottom:28px}.step{height:6px;flex:1;border-radius:99px;background:#e3e6dd}.step.done,.step.current{background:var(--leaf)}.step-label{display:flex;justify-content:space-between;color:var(--muted);font-size:13px;margin-top:8px}.phase{display:none}.phase.active{display:block}.phase h2{font-size:30px;margin-bottom:5px}.context{margin:24px 0;display:grid;gap:11px}.line{display:flex;gap:13px;align-items:flex-start;padding:13px 15px;border-radius:15px}.line:hover{background:#f3f3e9}.speaker{width:39px;height:39px;flex:none;border-radius:13px;background:var(--sage);display:grid;place-items:center;font-weight:800;color:var(--leaf)}.speak{border:0;background:transparent;color:var(--leaf);font-size:18px;margin-left:auto;padding:4px 6px}.word{border:0;background:transparent;padding:1px 2px;border-bottom:1.5px dotted #819178;border-radius:2px;cursor:help}.word:hover,.word:focus-visible{background:#edf1e5;outline:none}.helper-off .word{border-bottom-color:transparent}.pinyin-tip{position:fixed;z-index:80;display:flex;align-items:baseline;gap:8px;max-width:calc(100vw - 24px);padding:8px 12px;border:1px solid #d9dece;border-radius:11px;background:#fffdf7;color:var(--ink);box-shadow:0 10px 28px rgba(54,67,49,.18);opacity:0;visibility:hidden;pointer-events:none;transform:translateY(4px);transition:opacity .14s ease,transform .14s ease,visibility .14s}.pinyin-tip.show{opacity:1;visibility:visible;transform:translateY(0)}.pinyin-tip strong{font-size:14px}.pinyin-tip span{color:var(--leaf);font-size:15px;letter-spacing:.04em}.lesson-actions{display:flex;justify-content:space-between;align-items:center;margin-top:28px;border-top:1px solid var(--line);padding-top:20px}.ghost{border:0;background:transparent;color:var(--muted);padding:10px}.vocab-display{text-align:center;padding:25px 10px}.hanzi{font:700 64px/1.2 serif;margin-bottom:4px}.pinyin{color:var(--leaf);font-size:18px;letter-spacing:.08em}.meaning{color:var(--muted)}.choice-grid{display:grid;gap:10px;max-width:520px;margin:24px auto}.choice{background:white;border:1px solid var(--line);border-radius:14px;padding:13px 17px;text-align:left}.choice:hover,.choice.selected{border-color:#86997c;background:#eef3e9}.choice.correct{border-color:#718b66;background:#e3eddc}.feedback{display:none;max-width:520px;margin:0 auto;background:#eef3e9;padding:14px 17px;border-radius:14px}.feedback.show{display:block}.grammar-box{background:#f1f2e7;border-left:4px solid var(--leaf);border-radius:4px 16px 16px 4px;padding:20px 23px;margin:24px 0}.pattern{font-size:23px;font-weight:750}.blank{display:inline-block;min-width:100px;border-bottom:2px solid var(--leaf);text-align:center}.audio-box{background:linear-gradient(135deg,#edf0e5,#e0e8d9);border-radius:20px;padding:30px;text-align:center;margin:22px 0}.bigplay{width:68px;height:68px;border-radius:50%;border:0;background:var(--leaf);color:white;font-size:24px;margin:10px}.wave{height:38px;display:flex;align-items:center;justify-content:center;gap:4px}.wave i{width:3px;height:var(--h);background:#91a188;border-radius:9px}.recording{background:#9b6f61!important;box-shadow:0 0 0 8px rgba(155,111,97,.15)}.record-tools{display:flex;align-items:center;justify-content:center;gap:8px;flex-wrap:wrap}.privacy-note{margin:10px 0 0;font-size:13px;color:var(--muted)}.speech-result{display:none;margin:18px 0 6px;padding:20px;border:1px solid #d9dfd0;border-radius:18px;background:#fffdf8;text-align:left}.speech-result.show{display:block}.speech-result-head{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:14px}.speech-score{display:flex;align-items:baseline;gap:3px;color:var(--leaf)}.speech-score b{font-size:34px;line-height:1}.speech-score small{font-size:13px}.speech-transcript{padding:13px 15px;border-radius:13px;background:#f1f2e9;margin:8px 0 14px;font-size:18px}.speech-feedback{display:grid;gap:8px;margin:0;padding:0;list-style:none}.speech-feedback li{display:flex;gap:9px;align-items:flex-start}.speech-feedback i{width:21px;height:21px;flex:none;border-radius:50%;background:var(--sage);color:var(--leaf);font-style:normal;text-align:center;line-height:21px;font-size:12px;font-weight:800}.speech-actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:16px}.complete{text-align:center;padding:24px}.complete-mark{width:92px;height:92px;border-radius:50%;background:var(--sage);display:grid;place-items:center;margin:10px auto 22px;font-size:40px;color:var(--leaf)}.score-row{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;max-width:520px;margin:28px auto}.score{background:#f1f2e8;border-radius:15px;padding:14px}.score b{font-size:24px;display:block}.outline-card{box-shadow:none;border:1px solid var(--line);background:rgba(255,255,255,.45)}.outline-list{display:grid;gap:7px}.outline-item{padding:10px 12px;border-radius:12px;display:flex;justify-content:space-between;color:var(--muted);font-size:14px}.outline-item.now{background:var(--sage);color:var(--ink);font-weight:700}.tag{font-size:12px;background:#eef0e8;padding:3px 7px;border-radius:99px}
    .review-layout{display:grid;grid-template-columns:1fr 340px;gap:22px}.review-hero{padding:30px}.review-top{display:flex;justify-content:space-between;gap:20px}.ring{width:94px;height:94px;border-radius:50%;background:conic-gradient(var(--leaf) 0 69%,#e2e5db 69%);display:grid;place-items:center;flex:none}.ring:after{content:"17";width:72px;height:72px;border-radius:50%;background:var(--paper);display:grid;place-items:center;font-size:25px;font-weight:800}.review-types{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:28px 0}.review-type{border:1px solid var(--line);border-radius:16px;padding:16px;background:#fffefa}.review-type b{display:block;margin-top:11px}.review-type small{color:var(--muted)}.timeline{display:grid;grid-template-columns:repeat(5,1fr);gap:4px;margin:22px 0 8px}.timepoint{text-align:center;position:relative;padding-top:20px;font-size:13px;color:var(--muted)}.timepoint:before{content:"";position:absolute;top:5px;left:0;right:0;height:2px;background:#d8ddd1}.timepoint:first-child:before{left:50%}.timepoint:last-child:before{right:50%}.timepoint i{position:absolute;top:0;left:50%;width:12px;height:12px;border-radius:50%;background:var(--leaf);transform:translateX(-50%);border:3px solid #edf1e7;box-sizing:content-box}.mini-practice{margin-top:18px;padding:18px;background:#f3f1e8;border-radius:16px}.mini-practice label{display:block;font-weight:700;margin-bottom:9px}.mini-practice input{width:100%;border:1px solid var(--line);border-radius:12px;padding:12px;background:white}.review-note li{margin:10px 0;color:var(--muted)}
    .dict-search{display:flex;gap:10px;max-width:700px;margin:24px 0}.dict-search input{flex:1;border:1px solid var(--line);background:rgba(255,255,255,.78);border-radius:15px;padding:14px 17px;outline:none}.dict-entry{display:grid;grid-template-columns:1fr .75fr;gap:22px}.entry-head{display:flex;justify-content:space-between;align-items:flex-start;border-bottom:1px solid var(--line);padding-bottom:20px;margin-bottom:20px}.entry-word{font:700 48px/1 serif}.entry-pinyin{color:var(--leaf);letter-spacing:.08em;margin-top:8px}.sense{margin:18px 0}.example{background:#f3f2e8;border-radius:15px;padding:15px 17px;margin:10px 0}.compare{background:#e8ede1;border-radius:18px;padding:20px}.saved-words{display:flex;flex-wrap:wrap;gap:8px}.saved-words span{background:#f0f1e8;border:1px solid var(--line);padding:8px 11px;border-radius:12px}
    .profile-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px}.profile-top{grid-column:1/-1;display:flex;align-items:center;gap:18px}.large-avatar{width:72px;height:72px;border-radius:22px;background:var(--sage-2);display:grid;place-items:center;font-size:25px;font-weight:800}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.stat{background:#f1f2e8;border-radius:16px;padding:16px}.stat b{font-size:24px;display:block}.settings{display:grid;gap:14px}.setting{display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-bottom:1px solid var(--line)}
    .modal-wrap{position:fixed;inset:0;background:rgba(35,42,34,.28);display:none;align-items:center;justify-content:center;padding:18px;z-index:20;backdrop-filter:blur(5px)}.modal-wrap.show{display:flex}.modal{width:min(430px,100%);background:#fffdf7;border-radius:24px;padding:26px;box-shadow:0 24px 80px rgba(30,38,28,.24);position:relative}.close{position:absolute;right:16px;top:14px;border:0;background:#f0f1e9;width:34px;height:34px;border-radius:11px;font-size:18px}.modal-word{font:700 42px/1.2 serif}.modal-pinyin{color:var(--leaf);font-size:18px;margin:6px 0}.modal-meaning{font-size:18px;margin-bottom:17px}.toast{position:fixed;left:50%;bottom:26px;transform:translate(-50%,20px);background:#334033;color:white;padding:11px 17px;border-radius:13px;opacity:0;pointer-events:none;transition:.25s;z-index:30}.toast.show{opacity:1;transform:translate(-50%,0)}
    @media(max-width:980px){.app{grid-template-columns:1fr;padding:14px 14px 92px}.sidebar{position:fixed;z-index:10;left:12px;right:12px;bottom:10px;top:auto;min-height:auto;padding:8px 10px;border-radius:22px}.brand,.side-bottom{display:none}.nav{grid-template-columns:repeat(5,1fr);gap:2px}.nav button{justify-content:center;flex-direction:column;gap:2px;padding:7px 2px;font-size:12px}.nav svg{width:19px}.topbar{margin-bottom:15px}.grid,.learn-layout,.review-layout,.dict-entry{grid-template-columns:1fr}.outline-card{display:none}.review-types{grid-template-columns:1fr 1fr}main{padding:4px}.home-head{align-items:flex-start}.date-chip{display:none}}
    @media(max-width:620px){h1{font-size:32px}.lesson-card{min-height:300px;padding:24px}.lesson-card h2{font-size:29px;margin-top:45px}.home-head{display:block}.section-head{display:block}.card{padding:20px}.review-top{display:block}.ring{margin:15px 0}.review-types{grid-template-columns:1fr 1fr}.score-row,.stats{grid-template-columns:1fr 1fr}.profile-grid{grid-template-columns:1fr}.profile-top{grid-column:auto}.top-actions .iconbtn:first-child{display:none}.lesson-main{min-height:0}.step-label{font-size:11px}.entry-word{font-size:40px}}
    body[data-theme="qinghe"]{--cream:#f7f3e7;--paper:#fffdf7;--sage:#dfe7d6;--sage-2:#cbd8bf;--leaf:#60735a;--ink:#29322a;--muted:#748073;--line:#dde2d4;--warm:#e9dbb9;--soft:#f2eddf;--theme-a:#f6f1df;--theme-b:#eef2df}
    body[data-theme="mist"]{--cream:#f3f1e8;--paper:#fdfbf6;--sage:#dce7eb;--sage-2:#c5d7dd;--leaf:#526c7a;--ink:#26343b;--muted:#708087;--line:#d7dfe2;--warm:#e7dfcc;--soft:#edf1f2;--theme-a:#f4f1e8;--theme-b:#e9f0f1}
    body[data-theme="tea"]{--cream:#f4efe6;--paper:#fffcf7;--sage:#e7ddd0;--sage-2:#d9c8b7;--leaf:#765f4c;--ink:#382f29;--muted:#7e7168;--line:#e2d8cd;--warm:#dfcaa9;--soft:#f2ebe2;--theme-a:#f5efe5;--theme-b:#eee4d8}
    body[data-theme="wisteria"]{--cream:#f3f1f0;--paper:#fcfafb;--sage:#e3e1ea;--sage-2:#cfccd9;--leaf:#665f78;--ink:#302e38;--muted:#77727e;--line:#dedbe3;--warm:#ddd2c7;--soft:#efedf2;--theme-a:#f4f1ef;--theme-b:#ebe9f0}
    body[data-theme]{background:linear-gradient(135deg,var(--theme-a),var(--theme-b));transition:background .25s,color .25s}body[data-theme] .sidebar,body[data-theme] .card,body[data-theme] .modal{background:color-mix(in srgb,var(--paper) 92%,transparent)}body[data-theme] .lesson-card{background:linear-gradient(145deg,var(--sage),color-mix(in srgb,var(--sage) 44%,var(--paper)))}body[data-theme] .modebox,body[data-theme] .secondary,body[data-theme] .grammar-box,body[data-theme] .stat,body[data-theme] .count,body[data-theme] .example,body[data-theme] .mini-practice{background:var(--soft)}body[data-theme] .audio-box{background:linear-gradient(135deg,var(--soft),var(--sage))}
    .hidden{display:none!important}.catalog-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:20px}.level-filters{display:flex;gap:8px;flex-wrap:wrap}.filter-btn{border:1px solid var(--line);background:var(--paper);border-radius:999px;padding:8px 13px;color:var(--muted);font-weight:700}.filter-btn.active{background:var(--leaf);border-color:var(--leaf);color:white}.course-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:20px 0}.course-summary .card{padding:17px}.course-summary b{display:block;font-size:25px}.course-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.course-card{display:flex;flex-direction:column;min-height:245px}.course-card-top{display:flex;justify-content:space-between;gap:8px;align-items:center}.course-number{font-size:12px;color:var(--muted);font-weight:700}.course-card h3{margin:18px 0 5px;font-size:21px}.course-scene{color:var(--muted);font-size:14px}.course-focus{margin:14px 0;padding:11px 12px;border-radius:12px;background:var(--soft);font-size:14px}.course-card-actions{margin-top:auto;display:flex;justify-content:space-between;align-items:center;gap:8px}.status-ready{color:var(--leaf);font-size:13px;font-weight:750}.status-plan{color:var(--muted);font-size:13px}.lesson-back{display:flex;align-items:center;gap:10px;margin-bottom:15px}.course-modal-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:18px 0}.course-modal-item{background:var(--soft);padding:12px;border-radius:12px}.course-modal-item small{display:block;color:var(--muted)}
    .home-path{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;margin-top:22px}.path-level{display:flex;align-items:center;gap:15px}.path-level b{font-size:27px;color:var(--leaf)}.path-level small{display:block;color:var(--muted)}
    .review-workspace{display:none;margin-top:20px}.review-workspace.show{display:block}.review-progress{height:7px;background:var(--line);border-radius:99px;overflow:hidden;margin:12px 0 22px}.review-progress span{display:block;height:100%;background:var(--leaf);transition:width .25s}.review-prompt{font-size:22px;font-weight:750;margin:10px 0 17px}.review-answer-input{width:100%;border:1px solid var(--line);background:var(--paper);border-radius:13px;padding:13px;margin-bottom:10px}.review-feedback{display:none;background:var(--soft);border-left:4px solid var(--leaf);border-radius:4px 13px 13px 4px;padding:13px 15px;margin-top:14px}.review-feedback.show{display:block}.review-grades{display:none;gap:8px;flex-wrap:wrap;margin-top:14px}.review-grades.show{display:flex}.review-grades button{flex:1;min-width:90px}.schedule-list{display:grid;gap:9px;margin-top:18px}.schedule-row{display:flex;justify-content:space-between;padding:10px 12px;border-bottom:1px solid var(--line)}
    .dict-suggestions{display:flex;gap:8px;flex-wrap:wrap;margin:-10px 0 20px}.dict-suggestions button{border:1px solid var(--line);background:var(--paper);border-radius:999px;padding:7px 11px;color:var(--muted)}.dict-meta-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:18px 0}.dict-meta{background:var(--soft);border-radius:12px;padding:11px}.dict-meta small{display:block;color:var(--muted)}.source-note{font-size:13px;color:var(--muted);border-top:1px solid var(--line);padding-top:14px;margin-top:18px}.recent-word{cursor:pointer}
    .theme-card{grid-column:1/-1}.theme-options{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:17px}.theme-option{border:2px solid transparent;background:var(--paper);border-radius:16px;padding:13px;text-align:left}.theme-option.active{border-color:var(--leaf)}.theme-swatches{display:flex;margin-bottom:10px}.theme-swatches i{width:28px;height:28px;border-radius:50%;border:2px solid white;margin-right:-6px;box-shadow:0 1px 5px rgba(0,0,0,.12)}.theme-option strong,.theme-option small{display:block}.theme-option small{color:var(--muted);margin-top:3px}.content-standard{grid-column:1/-1}.standard-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:11px;margin-top:16px}.standard-item{background:var(--soft);padding:14px;border-radius:14px}.standard-item b{display:block;color:var(--leaf);font-size:21px}.standard-item small{color:var(--muted)}
    @media(max-width:980px){.course-grid{grid-template-columns:1fr 1fr}.theme-options,.standard-grid{grid-template-columns:1fr 1fr}.home-path{grid-template-columns:1fr}}
    @media(max-width:620px){.catalog-head{display:block}.level-filters{margin-top:14px}.course-grid,.course-summary,.theme-options,.standard-grid,.course-modal-grid{grid-template-columns:1fr}.course-card{min-height:0}.dict-meta-grid{grid-template-columns:1fr}}
  </style>
</head>
<body class="helper-on" data-theme="qinghe">
<div class="app">
  <aside class="sidebar">
